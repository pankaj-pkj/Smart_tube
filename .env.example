# Copy this file to .env and edit.

# Flask session secret. Kuch bhi random lamba string daal do.
SECRET_KEY=change-this-to-a-long-random-string

# Optional simple lock. Blank chhod do to koi login nahi lagega (client ne bola tha
# security nahi chahiye). Value daal doge to har page se pehle ye PIN maangega.
APP_PIN=

# App ka public URL, https ke saath, bina trailing slash.
# YouTube OAuth redirect aur Instagram video fetch dono isi par depend karte hain.
# Local testing ke liye: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# Server port
PORT=8000

# Scheduler kitni der mein due uploads check kare (seconds)
TICK_SECONDS=30

# App har thodi der mein khud ko ek HTTP request bhejta hai taaki free hosting
# (Render/Koyeb waghera) use sula na de — sote hi schedule ruk jaata hai aur data
# bhi mit jaata hai. Iske liye PUBLIC_BASE_URL sahi hona zaruri hai.
# Apne PC ya paid plan par zarurat nahi — tab KEEP_ALIVE=0 kar do.
KEEP_ALIVE=1
KEEP_ALIVE_MINUTES=10

# SQLite file kahan rahegi. Khali chhodo to project folder mein banegi.
# Jis hosting par app folder restart par reset hota hai (Render free plan waghera)
# wahan ise persistent disk ke andar point karo, warna har restart par keys,
# connected account aur saare campaigns mit jayenge.
DB_PATH=

# Optional: keys yahan bhi rakh sakte ho. /enter page par khali dikhengi par kaam
# karengi, aur restart ke baad bhi bachi rahengi (DB mit jaye tab bhi).
# /enter par jo value save karoge wo in par bhaari padti hai.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
